# Run the Node application behind HTTPS on this exact origin. No trailing slash.
APP_ORIGIN=https://dinig.example.edu
PORT=3000
NODE_ENV=production
# Server-only direct/pooler PostgreSQL connection. Never put this in public/.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# CA certificate verification is required; use your provider's trusted chain.
DATABASE_SSL=true
# Existing CSC Supabase project, used ONLY to authenticate staff credentials.
SUPABASE_URL=https://udnyppmvkklcbyylqsxp.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_EXISTING_PROJECT_PUBLISHABLE_KEY
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to pseudonymize IP rate-limit keys; rotating resets those buckets.
RATE_LIMIT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Optional approved values; blank means no contacts/response claims shown.
EMERGENCY_GUIDANCE=
RESPONSE_GUIDANCE=
# HTTPS reverse proxy must OVERWRITE X-Forwarded-For; set only when configured.
TRUST_PROXY=false
# Optional, informational retention policy; no automatic deletion is performed.
RETENTION_DAYS=365
